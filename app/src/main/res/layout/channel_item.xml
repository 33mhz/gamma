<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="8dp">

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/channelAvatar"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="@dimen/size_post_item_avatar"
        android:layout_height="@dimen/size_post_item_avatar"
        tools:src="@tools:sample/avatars" />

    <TextView
        android:id="@+id/channelName"
        app:layout_constraintStart_toEndOf="@id/channelAvatar"
        app:layout_constraintTop_toTopOf="@id/channelAvatar"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:textStyle="bold"
        tools:text="Channel Name" />

    <TextView
        android:id="@+id/recentMessage"
        app:layout_constraintStart_toEndOf="@id/channelAvatar"
        app:layout_constraintTop_toBottomOf="@id/channelName"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginStart="8dp"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:maxLines="2"
        android:ellipsize="end"
        tools:text="Recent message text goes here..." />

</androidx.constraintlayout.widget.ConstraintLayout>