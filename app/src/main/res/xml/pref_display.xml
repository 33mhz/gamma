<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:key="@string/pref_display_key"
    android:title="@string/display">
    <PreferenceCategory android:title="@string/pref_header_general">
        <SwitchPreferenceCompat
            app:defaultValue="true"
            app:key="@string/pref_show_avatar_key"
            app:title="@string/pref_show_avatar_title" />
        <SwitchPreferenceCompat
            app:defaultValue="@bool/pref_hide_feed_bot_avatar_default_value"
            app:dependency="@string/pref_show_avatar_key"
            app:key="@string/pref_hide_feed_bot_avatar_key"
            app:title="@string/pref_hide_feed_bot_avatar_title" />
        <DropDownPreference
            app:defaultValue="@string/pref_shape_of_avatar_key_default_value"
            app:entries="@array/shape_of_avatar"
            app:entryValues="@array/shape_of_avatar_values"
            app:key="@string/pref_shape_of_avatar_key"
            app:title="@string/pref_shape_of_avatar_title"
            app:useSimpleSummaryProvider="true" />
        <DropDownPreference
            android:defaultValue="0"
            android:entries="@array/dark_mode"
            android:entryValues="@array/dark_mode_values"
            android:key="@string/pref_dark_theme_key"
            android:title="@string/use_dark_theme"
            app:useSimpleSummaryProvider="true" />
        <io.pnut.gamma.presentation.view.ThemeColorPreference
            android:key="@string/pref_change_primary_color_key"
            android:title="@string/change_theme_color"
            app:widgetLayout="@layout/primary_color_preview" />
    </PreferenceCategory>
</PreferenceScreen>
